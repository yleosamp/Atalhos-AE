/* Shared ExtendScript action: panel button and native Scripts-menu shortcut. */
(function registerAtalhosNull(global) {
    function selectedNull(comp) {
        var selected = comp.selectedLayers;
        var result = null;
        var i;
        for (i = 0; i < selected.length; i += 1) {
            if (selected[i].nullLayer && (!result || selected[i].index < result.index)) {
                result = selected[i];
            }
        }
        return result;
    }

    function run() {
        var comp = app.project && app.project.activeItem;
        var parent;
        var anchor;
        var layer;
        var i;
        if (!comp || !(comp instanceof CompItem)) {
            alert("Abra ou selecione uma composicao primeiro.", "Atalhos AE");
            return null;
        }
        // Capture the actual Layer object before addNull changes indices and
        // selection. Names are not identities: a renamed null still works.
        parent = selectedNull(comp);
        app.beginUndoGroup(parent ? "Criar nulo filho" : "Criar nulo");
        try {
            layer = comp.layers.addNull(comp.duration);
            layer.name = "Null";
            if (parent) {
                layer.threeDLayer = parent.threeDLayer;
                // No compensation on the new default transforms: inherit the
                // parent's rotation/scale. Do not reparent/move the old null.
                layer.setParentWithJump(parent);
                anchor = parent.property("ADBE Transform Group").property("ADBE Anchor Point");
                anchor = anchor.valueAtTime(comp.time, false);
                // Child position is in parent's local coordinates. Matching
                // its anchor aligns the two pivots, including a custom anchor.
                layer.property("ADBE Transform Group").property("ADBE Position").setValue(
                    layer.threeDLayer ? [anchor[0], anchor[1], anchor.length > 2 ? anchor[2] : 0] : [anchor[0], anchor[1]]
                );
                layer.moveBefore(parent);
            } else {
                layer.property("ADBE Transform Group").property("ADBE Position").setValue([comp.width / 2, comp.height / 2]);
            }
            for (i = 1; i <= comp.numLayers; i += 1) comp.layer(i).selected = false;
            layer.selected = true;
            return layer;
        } catch (error) {
            alert("Nao foi possivel criar o nulo.\n\n" + error.toString() + "\nUse Desfazer se uma camada parcial foi criada.", "Atalhos AE");
            return null;
        } finally {
            app.endUndoGroup();
        }
    }
    global.__ATALHOS_AE_NULL_ACTION__ = { run: run };
}($.global));

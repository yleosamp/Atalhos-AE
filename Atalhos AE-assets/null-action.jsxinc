/* Shared ExtendScript action: panel button and native Scripts-menu shortcut. */
(function registerAtalhosNull(global) {
    function selectedNull(comp) {
        var selected = comp.selectedLayers;
        var result = null;
        var i;
        for (i = 0; i < selected.length; i += 1) {
            if (selected[i].nullLayer && (!result || selected[i].index < result.index)) {
                result = selected[i];
            }
        }
        return result;
    }

    function run() {
        var comp = app.project && app.project.activeItem;
        var child;
        var previousParent;
        var pivot;
        var transform;
        var layer;
        var i;
        if (!comp || !(comp instanceof CompItem)) {
            alert("Abra ou selecione uma composicao primeiro.", "Atalhos AE");
            return null;
        }
        // Capture the actual Layer object before addNull changes indices and
        // selection. Names are not identities: a renamed null still works.
        child = selectedNull(comp);
        if (child && child.locked) {
            alert("Desbloqueie o nulo selecionado antes de criar o controlador.", "Atalhos AE");
            return null;
        }
        app.beginUndoGroup(child ? "Criar nulo controlador" : "Criar nulo");
        try {
            if (child) {
                previousParent = child.parent;
                pivot = child.property("ADBE Transform Group").property("ADBE Position").valueAtTime(comp.time, false);
            }
            layer = comp.layers.addNull(comp.duration);
            layer.name = "Null";
            if (child) {
                layer.threeDLayer = child.threeDLayer;
                if (previousParent) layer.setParentWithJump(previousParent);
                pivot = layer.threeDLayer ? [pivot[0], pivot[1], pivot.length > 2 ? pivot[2] : 0] : [pivot[0], pivot[1]];
                transform = layer.property("ADBE Transform Group");
                // A fresh null has rotation/orientation zero and scale 100.
                // Position == Anchor yields an identity local matrix. Insert
                // it into the old hierarchy without rewriting the old keys.
                // The controller's pivot remains at the selected null's pivot.
                transform.property("ADBE Anchor Point").setValue(pivot);
                transform.property("ADBE Position").setValue(pivot);
                layer.moveBefore(child);
                child.setParentWithJump(layer);
            } else {
                layer.property("ADBE Transform Group").property("ADBE Position").setValue([comp.width / 2, comp.height / 2]);
            }
            for (i = 1; i <= comp.numLayers; i += 1) comp.layer(i).selected = false;
            layer.selected = true;
            return layer;
        } catch (error) {
            alert("Nao foi possivel criar o nulo.\n\n" + error.toString() + "\nUse Desfazer se uma camada parcial foi criada.", "Atalhos AE");
            return null;
        } finally {
            app.endUndoGroup();
        }
    }
    global.__ATALHOS_AE_NULL_ACTION__ = { run: run };
}($.global));
